if(NOT EXISTS "${BINARY}")
  message(FATAL_ERROR "Missing executable: ${BINARY}")
endif()
file(SIZE "${BINARY}" bytes)
message(STATUS "Launcher size: ${bytes} bytes")
if(bytes GREATER 15728640)
  message(FATAL_ERROR "Launcher exceeds the 15 MiB hard maximum")
elseif(bytes GREATER 10485760)
  message(WARNING "Launcher exceeds the 10 MiB target")
endif()
