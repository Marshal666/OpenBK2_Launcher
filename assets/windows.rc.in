#include <windows.h>
1 ICON "@CMAKE_SOURCE_DIR@/assets/launcher.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OpenBK2 Launcher"
      VALUE "ProductName", "OpenBK2 Launcher"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "OpenBK2 Launcher contributors; MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
