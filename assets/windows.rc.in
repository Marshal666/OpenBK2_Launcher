#include <windows.h>
1 ICON "@CMAKE_SOURCE_DIR@/assets/launcher.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OpenBK2 Launcher"
      VALUE "ProductName", "OpenBK2 Launcher"
      VALUE "FileVersion", "0.1.0"
      VALUE "LegalCopyright", "OpenBK2 Launcher contributors; MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
